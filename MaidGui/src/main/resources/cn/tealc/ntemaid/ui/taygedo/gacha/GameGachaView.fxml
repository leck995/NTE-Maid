<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Spacer?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="gacha" stylesheets="@../../../css/system/Account.css,@../../../css/system/gacha.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.taygedo.gacha.GameGachaView">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>

            <!-- 正常内容 -->
            <VBox fx:id="contentPane" spacing="10.0">
                <children>
                    <!-- 账号选择栏 -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <children>
                            <Label styleClass="title-3" text="选择账号:" />
                            <ComboBox fx:id="accountCombo" prefWidth="220.0" />
                            <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#onRefresh" styleClass="accent" text="刷新">
                                <graphic>
                                    <FontIcon iconLiteral="mdmz-refresh" />
                                </graphic>
                            </Button>
                     <Spacer />
                     <Label styleClass="text-subtle" text="抽卡数据每小时更新，可能存在延迟" />
                        </children>
                    </HBox>

                    <!-- 错误信息 -->
                    <Label fx:id="statusLabel" managed="false" styleClass="status-label" text="" textFill="red" visible="false" />

                    <!-- 玩家信息卡片 -->
                    <HBox fx:id="playerInfoPane" alignment="CENTER_LEFT" spacing="12.0" styleClass="player-info">
                        <children>
                            <ImageView fx:id="avatarView" fitHeight="48.0" fitWidth="48.0" />
                            <Label fx:id="roleNameLabel" styleClass="title-3" text="" />
                            <Separator orientation="VERTICAL" />
                            <Label fx:id="levelLabel" styleClass="player-level" text="" />
                            <Separator orientation="VERTICAL" />
                     <Spacer />
                            <Label fx:id="luckLabel" styleClass="player-luck" text="" />
                        </children>
                        <padding>
                            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                        </padding>
                    </HBox>
                      <HBox fx:id="poolCardsPane" fillHeight="true" spacing="25.0" VBox.vgrow="ALWAYS">
                          <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                          </padding>
                      </HBox>
                </children>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
            </VBox>

            <!-- 空状态 -->
            <VBox fx:id="emptyPane" alignment="CENTER" spacing="15.0">
                <children>
                    <FontIcon iconLiteral="mdal-inbox" iconSize="48" styleClass="empty-icon" />
                    <Label styleClass="title-3" text="暂无抽卡数据" />
                    <Label text="请先选择一个已登录的账号" textFill="#666" />
                </children>
            </VBox>

            <!-- 加载指示器 -->
            <ProgressIndicator fx:id="loadingIndicator" maxHeight="40" maxWidth="40" visible="false" />

        </children>
    </StackPane>
</AnchorPane>
