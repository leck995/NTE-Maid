<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  角色面板视图（三段式纵向布局），嵌入 HomeView 右侧区域。
  顶部：个人标识区  中部：核心数据网格  底部：实时动态卡片
  整个面板被一个外层背景容器包裹
-->
<VBox styleClass="role-board" stylesheets="@../../css/Home.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cn.tealc.ntemaid.ui.system.RoleBoardByTaygedoView">

   <!-- 外层背景容器，包裹所有子内容 -->
   <VBox styleClass="board-container">

      <!-- 状态提示 -->
      <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" visible="false" />

      <!-- 空状态 -->
      <VBox fx:id="emptyPane" alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
         <Label text="选择账号以加载角色数据" styleClass="empty-hint" />
      </VBox>

      <!-- 内容区 -->
      <VBox fx:id="contentPane" spacing="10.0">

         <!-- ============================== -->
         <!-- 顶部：个人标识区                 -->
         <!-- ============================== -->
         <VBox styleClass="identity-section">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <!-- 头像 -->
               <ImageView fx:id="avatarView" styleClass="avatar-image" fitWidth="40" fitHeight="40" />
               <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                  <Label fx:id="roleDisplayLabel" styleClass="role-name" text="" />
                  <Label fx:id="levelLabel" styleClass="level-badge" text="" />
               </VBox>
               <!-- 切换 + 刷新按钮组 -->
               <HBox alignment="CENTER_RIGHT" spacing="4.0">
                  <Button fx:id="switchBtn" onAction="#onSwitchAccount" styleClass="switch-btn">
                     <graphic>
                        <FontIcon iconLiteral="mdal-arrow_drop_down" />
                     </graphic>
                  </Button>
                  <Button fx:id="refreshBtn" onAction="#onRefresh" styleClass="refresh-btn">
                     <graphic>
                        <FontIcon fx:id="refreshIcon" iconLiteral="mdmz-refresh" />
                     </graphic>
                  </Button>
               </HBox>
            </HBox>
            <!-- UID + 复制按钮 -->
            <HBox fx:id="uidRow" alignment="CENTER_LEFT" spacing="5.0">
               <Label fx:id="uidLabel" styleClass="uid-text" text="" />
               <Button fx:id="copyUidBtn" onAction="#copyUid" styleClass="copy-btn">
                  <graphic>
                     <FontIcon iconLiteral="mdal-content_copy" styleClass="copy-icon" />
                  </graphic>
               </Button>
            </HBox>
         </VBox>

         <!-- ============================== -->
         <!-- 中部：核心数据网格 3列2行         -->
         <!-- ============================== -->
         <GridPane fx:id="coreDataGrid" styleClass="core-data-grid">
           <columnConstraints>
              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.3" />
              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.3" />
              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.4" />
           </columnConstraints>
           <rowConstraints>
              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
           </rowConstraints>

           <!-- 第一行 -->
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="0">
              <Label fx:id="loginDaysLabel" styleClass="data-value" text="" />
              <Label text="活跃天数" styleClass="data-name" />
           </VBox>
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0">
              <Label fx:id="charCountLabel" styleClass="data-value" text="" />
              <HBox alignment="CENTER" spacing="2.0">
                 <Label text="已有角色" styleClass="data-name" />
                 <FontIcon iconLiteral="mdmz-play_arrow" styleClass="arrow" />
              </HBox>
           </VBox>
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="0">
              <Label fx:id="achievementLabel" styleClass="data-value" text="" />
              <HBox alignment="CENTER" spacing="2.0">
                 <Label text="达成成就" styleClass="data-name" />
                 <FontIcon iconLiteral="mdmz-play_arrow" styleClass="arrow" />
              </HBox>
           </VBox>

           <!-- 第二行 -->
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1">
              <Label fx:id="worldLevelLabel" styleClass="data-value" text="" />
              <Label text="猎人等级" styleClass="data-name" />
           </VBox>
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1">
              <Label fx:id="tycoonLevelLabel" styleClass="data-value" text="" />
              <Label text="大亨等级" styleClass="data-name" />
           </VBox>
           <VBox styleClass="data-cell" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1">
              <Label fx:id="serverLabel" styleClass="data-value" text="" />
              <Label text="服务器" styleClass="data-name" />
           </VBox>
         </GridPane>

         <!-- ============================== -->
         <!-- 底部：实时动态卡片               -->
         <!-- ============================== -->
         <VBox styleClass="realtime-card">
            <!-- 卡片顶部灰色横杆 -->
            <Region styleClass="card-rod" />
            <Label text="实时信息" styleClass="realtime-title" />

            <!-- 体力 / 活力 两列 -->
            <HBox alignment="CENTER" spacing="10.0">
               <HBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
                  <ImageView fx:id="staminaIconView" styleClass="realtime-icon" />
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <Label fx:id="staminaLabel" styleClass="realtime-value" text="" />
                     <Label text="体力" styleClass="realtime-label" />
                  </VBox>
               </HBox>
               <Separator orientation="VERTICAL" styleClass="cell-separator" />
               <HBox alignment="CENTER_LEFT" spacing="6.0" HBox.hgrow="ALWAYS">
                  <ImageView fx:id="cityStaminaIconView" styleClass="realtime-icon" />
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <Label fx:id="cityStaminaLabel" styleClass="realtime-value" text="" />
                     <Label text="活力" styleClass="realtime-label" />
                  </VBox>
               </HBox>
            </HBox>

            <!-- 活跃度 / 周本 深色胶囊 -->
            <HBox alignment="CENTER" spacing="8.0">
               <HBox fx:id="activityCapsule" styleClass="capsule" alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label fx:id="activityLabel" styleClass="capsule-value" text="" />
                  <Label text="活跃度" styleClass="capsule-label" />
               </HBox>
               <HBox fx:id="weeklyCapsule" styleClass="capsule" alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS">
                  <Label fx:id="weeklyCountLabel" styleClass="capsule-value" text="" />
                  <Label text="周本" styleClass="capsule-label" />
               </HBox>
            </HBox>
         </VBox>
      </VBox>
   </VBox>
</VBox>
