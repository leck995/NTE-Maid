<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="280.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.taygedo.account.TaygedoLoginView">
   <children>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label text="塔吉多验证码登录" textFill="#1a73e8">
               <font><Font name="System Bold" size="20.0" /></font>
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Label>

            <Label text="手机号" />
            <TextField fx:id="phoneField" promptText="请输入11位手机号" maxWidth="300" />

            <Label text="验证码" />
            <TextField fx:id="captchaField" promptText="请输入短信验证码" maxWidth="200" />

            <Button fx:id="sendCaptchaBtn" mnemonicParsing="false"
                    text="获取验证码" maxWidth="120"
                    onAction="#onSendCaptcha" />

            <Button fx:id="loginBtn" mnemonicParsing="false"
                    text="登录" maxWidth="300"
                    onAction="#onLogin" />

            <Label fx:id="statusLabel" text="" textFill="#666" wrapText="true" />
         </children>
         <padding><Insets top="28.0" right="28.0" bottom="28.0" left="28.0" /></padding>
      </VBox>
   </children>
</AnchorPane>
