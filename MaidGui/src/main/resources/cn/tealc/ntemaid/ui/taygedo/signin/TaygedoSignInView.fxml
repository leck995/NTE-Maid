<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="taygedo-signin" stylesheets="@../../../css/system/Account.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.taygedo.signin.TaygedoSignInView">
   <children>
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- 正常签到内容 -->
            <VBox fx:id="contentPane" spacing="15.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <Label styleClass="title-3" text="选择账号:" />
                        <ComboBox fx:id="accountCombo" prefWidth="250.0" />
                        <Button fx:id="signInBtn" mnemonicParsing="false" onAction="#onSignIn" styleClass="accent" text="签到">
                           <graphic>
                              <FontIcon iconLiteral="mdal-check_circle_outline" />
                           </graphic>
                        </Button>
                        <Button fx:id="signInAllBtn" mnemonicParsing="false" onAction="#onSignInAll" styleClass="accent" text="全部签到">
                           <graphic>
                              <FontIcon iconLiteral="mdal-done_all" />
                           </graphic>
                        </Button>
                        <ToggleSwitch fx:id="autoSignSwitch" labelPosition="RIGHT" text="自动签到" />
                     </children>
                  </HBox>
                  <Label fx:id="statusLabel" styleClass="status-label" text="" />
                  <ScrollPane fitToWidth="true" styleClass="reward-scroll" VBox.vgrow="ALWAYS">
                     <content>
                        <FlowPane fx:id="rewardPane" hgap="10.0" vgap="10.0" />
                     </content>
                  </ScrollPane>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
            <!-- 无账号提示 -->
            <VBox fx:id="emptyPane" alignment="CENTER" spacing="15.0" visible="false">
               <children>
                  <FontIcon iconLiteral="mdmz-person_add_disabled" iconSize="48" />
                  <Label styleClass="title-3" text="暂无账号" />
                  <Label text="请先在账号管理中登录塔吉多账号" textFill="#666" />
                  <Button mnemonicParsing="false" onAction="#onGoToAccount" styleClass="accent" text="前往账号管理" visible="false" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
