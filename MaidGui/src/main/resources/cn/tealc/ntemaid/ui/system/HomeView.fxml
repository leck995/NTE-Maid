<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="648.0" prefWidth="1100.0" styleClass="home" stylesheets="@../../css/Home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.system.HomeView">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <right>
            <VBox alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0" spacing="8.0" styleClass="right" BorderPane.alignment="CENTER" />
         </right>
         <bottom>
            <VBox BorderPane.alignment="CENTER">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="bottom">
                     <children>
                        <Button disable="true" layoutX="122.0" layoutY="10.0" mnemonicParsing="false" onAction="#startUpdate" styleClass="func-btn" text="%ui.home.button.start_update" visible="false">
                           <graphic>
                              <FontIcon iconLiteral="mdsal-cloud_download" />
                           </graphic>
                        </Button>
                        <MenuButton layoutX="10.0" layoutY="10.0" mnemonicParsing="false" popupSide="TOP" styleClass="func-btn" text="%ui.home.button.browser">
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#toGameDir" text="%ui.home.button.browser.install_dir">
                                 <graphic>
                                    <FontIcon iconLiteral="mdsmz-snippet_folder" />
                                 </graphic>
                              </MenuItem>
                           </items>
                           <graphic>
                              <FontIcon iconLiteral="mdsal-folder" />
                           </graphic>
                        </MenuButton>
                        <MenuButton layoutX="546.0" layoutY="20.0" mnemonicParsing="false" popupSide="TOP" styleClass="func-btn" text="%ui.home.button.browser.screenshot_dir">
                           <items>
                              <MenuItem mnemonicParsing="false" onAction="#toGameAlbumDir" text="%ui.home.button.browser.screenshot_dir.game">
                                 <graphic>
                                    <FontIcon iconLiteral="mdsmz-snippet_folder" />
                                 </graphic>
                              </MenuItem>
                              <MenuItem mnemonicParsing="false" onAction="#toAppAlbumDir" text="%ui.home.button.browser.screenshot_dir.app">
                                 <graphic>
                                    <FontIcon iconLiteral="mdsmz-snippet_folder" />
                                 </graphic>
                              </MenuItem>
                           </items>
                           <graphic>
                              <FontIcon iconLiteral="mdal-image" />
                           </graphic>
                        </MenuButton>
                        <Button fx:id="gameTimeBtn" layoutX="841.0" layoutY="10.0" mnemonicParsing="false" onAction="#showGameTimerAlert" styleClass="func-btn" text="01小时15分钟">
                           <graphic>
                              <FontIcon iconLiteral="mdsmz-timer" />
                           </graphic>
                        </Button>
                        <Button fx:id="startGameBtn" mnemonicParsing="false" onAction="#startGame" text="%ui.home.button.start_game">
                           <graphic>
                              <FontIcon iconLiteral="mdral-games" />
                           </graphic>
                           <styleClass>
                              <String fx:value="accent" />
                              <String fx:value="start-btn" />
                           </styleClass>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </bottom>
         <top>
            <HBox BorderPane.alignment="CENTER" />
         </top>
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
      </BorderPane>
   </children>
</AnchorPane>
