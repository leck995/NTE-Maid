<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="root" prefHeight="720.0" prefWidth="1280.0" styleClass="playlist" stylesheets="@../../../css/game/music/AllMusicList.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.game.music.PlayListView">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <Pane HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#refreshMusicListEvent" styleClass="flat">
                           <graphic>
                              <FontIcon iconLiteral="mdrmz-refresh" />
                           </graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#createPlaylistEvent" text="创建">
                           <graphic>
                              <FontIcon iconLiteral="mdrmz-playlist_add" />
                           </graphic>
                           <styleClass>
                              <String fx:value="rounded" />
                              <String fx:value="success" />
                           </styleClass>
                        </Button>
                        <Button fx:id="playSelectedPlaylistBtn" mnemonicParsing="false" onAction="#playSelectedPlaylistEvent" text="播放全部">
                           <graphic>
                              <FontIcon iconLiteral="mdomz-play_circle_outline" />
                           </graphic>
                           <styleClass>
                              <String fx:value="rounded" />
                              <String fx:value="accent" />
                           </styleClass>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </HBox>
         </top>
         <left>
            <VBox BorderPane.alignment="CENTER">
               <children>
                  <ListView fx:id="sheetListview" prefHeight="200.0" prefWidth="200.0" styleClass="playlist-listview" VBox.vgrow="ALWAYS" />
               </children>
               <padding>
                  <Insets top="10.0" />
               </padding>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets top="10.0" />
               </padding>
               <children>
                  <TableView fx:id="musicTableView" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="musicIndexCol" editable="false" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false" />
                        <TableColumn fx:id="musicTitleCol" editable="false" minWidth="150.0" prefWidth="150.0" text="名称" />
                        <TableColumn fx:id="musicArtistCol" minWidth="100.0" prefWidth="100.0" text="歌手" />
                        <TableColumn fx:id="musicAlbumCol" prefWidth="75.0" text="专辑" />
                        <TableColumn fx:id="musicDurationCol" editable="false" maxWidth="100.0" minWidth="75.0" prefWidth="75.0" resizable="false" text="时长" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
