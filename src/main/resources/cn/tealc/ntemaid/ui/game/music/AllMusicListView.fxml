<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Spacer?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<BorderPane prefHeight="800.0" prefWidth="1000.0" styleClass="all-music" stylesheets="@../../../css/game/music/AllMusicList.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.ntemaid.ui.game.music.AllMusicListView">
   <top>
      <HBox prefHeight="50.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#playAllEvent" styleClass="accent" text="播放全部">
               <graphic>
                  <FontIcon iconLiteral="mdmz-play_arrow" />
               </graphic>
            </Button>
            <Button mnemonicParsing="false" onAction="#importMusicEvent" styleClass="nav-button" text="导入音乐">
               <graphic>
                  <FontIcon iconLiteral="mdoal-folder_open" />
               </graphic>
            </Button>
            <Spacer />
            <Button layoutX="129.0" layoutY="10.0" mnemonicParsing="false" onAction="#deleteAllMusicEvent" styleClass="danger" text="清空">
               <graphic>
                  <FontIcon iconLiteral="mdral-delete_outline" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>
   <center>
      <StackPane prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="allMusicTableView" prefHeight="200.0" prefWidth="200.0">
               <columns>
                  <TableColumn fx:id="allMusicIndexCol" editable="false" minWidth="50.0" prefWidth="50.0" resizable="false" sortable="false" />
                  <TableColumn fx:id="allMusicTitleCol" editable="false" minWidth="150.0" prefWidth="150.0" text="名称" />
                  <TableColumn fx:id="allMusicArtistCol" minWidth="100.0" prefWidth="100.0" text="歌手" />
                  <TableColumn fx:id="allMusicAlbumCol" prefWidth="75.0" text="专辑" />
                  <TableColumn fx:id="allMusicDurationCol" editable="false" maxWidth="100.0" minWidth="75.0" prefWidth="75.0" resizable="false" text="时长" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </StackPane>
   </center>
</BorderPane>
